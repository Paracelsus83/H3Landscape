<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>H3Landscape</OutputName>
    <Platforms>x86;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>..\$(Configuration)</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="License.rtf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Landscape\Landscape.vcxproj" />
    <ProjectReference Include="..\Patcher\Patcher.vcxproj" />
  </ItemGroup>
</Project>